# Variables de entorno de OfiExpress (valores de desarrollo).
# Copie este archivo como .env y cargue las variables antes de levantar los servicios.
# Nunca publique los valores reales en el codigo ni en el repositorio.

# MongoDB
MONGODB_URI=mongodb://localhost:27017

# Administrador de secretos (compatible con Vault KV v2)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-only-token

# Secretos entregados por el administrador de secretos
AUTH_INTROSPECTION_SECRET=gateway-auth-secret-789
BACKEND_SHARED_SECRET=gateway-backend-secret-456
INTERNAL_GATEWAY_SECRET=gateway-backend-secret-456
PAYMENT_PROVIDER_API_KEY=pay-provider-key-321

# URLs internas
AUTH_SERVICE_URL=http://127.0.0.1:8100
INVENTORY_URL=http://127.0.0.1:9000
ORDERS_URL=http://127.0.0.1:9100
PAYMENTS_URL=http://127.0.0.1:9300
GRAPHQL_URL=http://127.0.0.1:8090
